# ============================================================
# Groq Provider (4 keys for high-throughput fast tier)
# ============================================================
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=openai/gpt-oss-120b

# ============================================================
# Google Gemini
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ============================================================
# OpenRouter Provider — MUST use :free model
# ============================================================
# Verify the exact free model slug at:
# https://openrouter.ai/models?fmt=table&order=pricing-low-to-high
#
# Default (as of current OpenRouter free catalog):
#   google/gemma-3-27b-it:free
#
# Other free alternatives (verify availability):
#   meta-llama/llama-3.3-70b-instruct:free
#   nvidia/llama-3.1-nemotron-70b-instruct:free
#   qwen/qwen-2.5-72b-instruct:free
# ============================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI Research Evidence Verification System

# ============================================================
# Optional HuggingFace Fallback
# ============================================================
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_MODEL_FALLBACK=Qwen/Qwen2.5-32B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# ============================================================
# High-Throughput Scheduler Tuning
# ============================================================
SCHEDULER_MAX_CONCURRENCY=6
SCHEDULER_BATCH_SIZE=8
SCHEDULER_INTER_BATCH_DELAY=0.3
SCHEDULER_PROVIDER_COOLDOWN=30

# ============================================================
# Task-Specific Timeouts (seconds)
# ============================================================
TIMEOUT_QUERY_GENERATION=15.0
TIMEOUT_EVIDENCE_ANALYSIS=30.0
MAX_OUTPUT_TOKENS_ANALYSIS=4096
TIMEOUT_CONTRADICTION_PAIRS=10.0
MAX_OUTPUT_TOKENS_CONTRADICTION=512
TIMEOUT_FINAL_VERDICT=45.0
MAX_OUTPUT_TOKENS_FINAL_VERDICT=1024